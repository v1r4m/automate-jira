# cp .env.example .env 후 값을 채우세요. 변경 후에는 ./scripts/install-launchd.sh 재실행.

# --- GitHub ---
GH_TOKEN=                 # PAT (org 레포 읽기 권한). 비우면 gh auth token 사용
GH_ORG=fnf-es             # 대상 organization 이름
GH_AUTHOR=                # 비우면 토큰 소유자(=나)
GH_REPOS=                 # 비우면 org 전체, 특정 레포만: repo-a,repo-b
BRANCH_SCOPE=all          # all | default
LOOKBACK_HOURS=72         # 컴퓨터가 꺼져 있던 시간도 커버
SKIP_MERGE_COMMITS=true

# --- Jira Cloud ---
JIRA_BASE_URL=https://fnf.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=           # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=ITSM
JIRA_ISSUE_TYPE=작업            # ITSM 기준 (Task 아님)
JIRA_LABELS=auto-commit
JIRA_ASSIGNEE_ACCOUNT_ID=me   # me | none | <accountId>

# --- 머지되면 완료 ---
AUTO_DONE_ON_MERGE=true
MERGE_BASE_BRANCHES=      # 비우면 아무 브랜치로든 PR 머지 시 완료. 예: prd,main
JIRA_DONE_TRANSITION=     # 비우면 '완료' 분류의 첫 전환

# --- LLM 티켓 문구 (사내 AX Link 게이트웨이) ---
AX_LINK_API_KEY=          # svc_... 비우면 커밋 메시지를 그대로 사용
AX_LINK_MODEL=anthropic/claude-haiku-5.5
USE_LLM=true
SEND_DIFF=false           # true면 diff 일부(최대 6000자)도 LLM에 보냄

DRY_RUN=true
